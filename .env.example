# Chat (optional; direct queries and local RAG do not need this)
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Routes (optional; absent key provides an external map link)
OPENROUTESERVICE_API_KEY=

# Default: local multilingual model. Build once with python vector_rag.py build
RAG_EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional separate embedding service. Do not reuse the DeepSeek chat endpoint.
# RAG_EMBEDDING_BACKEND=api
# EMBEDDING_BASE_URL=https://your-embedding-service/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=your-embedding-model
OVERPASS_TOTAL_TIMEOUT=12
